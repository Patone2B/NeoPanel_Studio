{
  "name": "neopanel-studio",
  "productName": "NeoPanel Studio",
  "version": "1.2.2",
  "description": "NeoPanel Studio 1.2.2 - Tableau de bord local sécurisé pour Windows",
  "author": "Anton",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "make": "electron-forge make"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-squirrel": "^7.6.1",
    "@electron-forge/maker-zip": "^7.6.1",
    "@electron/rebuild": "^4.0.6",
    "electron": "^42.5.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "NeoPanel_Studio",
        "executableName": "NeoPanel_Studio",
        "icon": "assets/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "NeoPanel_Studio",
            "setupIcon": "assets/icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ]
    }
  }
}
